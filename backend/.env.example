# Copy to .env and fill with your Neon/Postgres connection string
NEON_CONNECTION_STRING=postgresql://<user>:<password>@<host>:<port>/<database>
# Optional: Firebase service account JSON as a single-line escaped JSON string
# Example: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: Google OAuth client ID (used to verify ID tokens if Firebase Admin is not configured)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server port
PORT=8080

# For local dev you may disable SSL verification, but for production keep it secure.
